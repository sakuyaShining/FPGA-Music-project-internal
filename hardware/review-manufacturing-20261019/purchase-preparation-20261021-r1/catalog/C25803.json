al-Elec-0603WAF1003T5E_C25803_front.jpg","https://assets.lcsc.com/images/lcsc/900x900/20221229_UNI-ROYAL-Uniroyal-Elec-0603WAF1003T5E_C25803_back.jpg","https://assets.lcsc.com/images/lcsc/900x900/20221229_UNI-ROYAL-Uniroyal-Elec-0603WAF1003T5E_C25803_blank.jpg"],"edaSvgInfo":{"schSvg":"//image.easyeda.com/component_svgs/prod/5ff01e5b28266f76e3c6ac889a7fdd07.svg?t=1713800144","pcbSvg":"//image.easyeda.com/component_svgs/prod/398691f1f785460098bbe5ee6590333c.svg?t=1713800144"},"faqs":[{"question":"What are the primary electrical specifications and physical characteristics of the UNI-ROYAL 0603WAF1003T5E resistor?","answer":"The UNI-ROYAL 0603WAF1003T5E is a fixed thick-film chip resistor with a nominal resistance of 100kΩ and a ±1% tolerance. It is supplied in a 0603 (1608 metric) surface-mount package with dimensions of 1.60 ±0.10 mm × 0.80 ±0.10 mm × 0.45 ±0.10 mm. The resistor has a 1/10W power rating at 70°C and is designed for automated placement and both wave and reflow soldering processes."},{"question":"What types of electronic applications is the 0603WAF1003T5E resistor intended for?","answer":"The 0603WAF1003T5E belongs to UNI-ROYAL's thick-film chip resistor series, which is intended for use in electronic equipment including GPS navigation devices, mobile phones, telecom equipment, PDAs, set-top boxes, and meters. Its standard 0603 surface-mount package is compatible with automated PCB assembly processes and standard SMT land patterns."},{"question":"How do temperature and power conditions affect the operation of this resistor?","answer":"The 0603WAF1003T5E has a 1/10W power rating at 70°C and an operating temperature range of -55°C to +155°C. For ambient temperatures above 70°C, the allowable power must be reduced according to the datasheet's derating curve. The resistor also has a maximum working voltage of 75V and a maximum overload voltage of 150V, subject to the rated power limitations."},{"question":"What PCB layout and assembly practices are recommended for this 0603 resistor?","answer":"The 0603WAF1003T5E is designed for automated SMT assembly and is suitable for both wave soldering and reflow soldering. The datasheet provides recommended 0603 land pattern dimensions for PCB layout. The part is supplied in a lead-free tape-and-reel package, supporting automated pick-and-place manufacturing."},{"question":"Why is the 0603WAF1003T5E suitable for automated electronics manufacturing?","answer":"The 0603WAF1003T5E combines a compact 0603 surface-mount package with compatibility for automated placement equipment, wave soldering, and reflow soldering. It is supplied in tape-and-reel packaging and is available in a lead-free version, making it suitable for high-volume SMT manufacturing processes."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/0a975aaa49b7c97f38a963127be4a823.pdf?productCode=C25803","authenticationList":null,"isRohsCert":null,"rohsCertType":null,"rohsCertList":null,"productDescEn":"100kΩ ±1% 100mW 0603 Thick Film Resistor","productIntroEn":"100kΩ ±1% 100mW 0603 Thick Film Resistor","paramVOList":[{"paramCode":"param_10837_n","paramName":"功率","paramNameEn":"Power(Watts)","paramValue":"100mW","paramValueEn":"100mW","paramValueEnForSearch":0.1,"isMain":true,"sortNumber":1,"sort":20},{"paramCode":"param_11205_n","paramName":"阻值","paramNameEn":"Resistance","paramValue":"100kΩ","paramValueEn":"100kΩ","paramValueEnForSearch":100000.0,"isMain":true,"sortNumber":1,"sort":7},{"paramCode":"param_11204_n","paramName":"最大工作电压","paramNameEn":"Voltage Rating","paramValue":"75V","paramValueEn":"75V","paramValueEnForSearch":75.0,"isMain":true,"sortNumber":1,"sort":18},{"paramCode":"param_11202","paramName":"电阻类型","paramNameEn":"Type","paramValue":"厚膜电阻","paramValueEn":"Thick Film Resistor","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":1},{"paramCode":"param_11185_s","paramName":"温度系数","paramNameEn":"Temperature Coefficient","paramValue":"±100ppm/℃","paramValueEn":"±100ppm/℃","paramValueEnForSe