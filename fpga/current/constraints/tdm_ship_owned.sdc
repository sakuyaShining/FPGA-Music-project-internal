#=============================================================================
# osc_additive_top.sdc —— 全项目第一份真实时序约束（2026-09-30）
#
# 背景：此前全项目没有任何 .sdc，时序报告里的 15.294ns"要求"是工具
#       自猜的（约 65.4 MHz），所有 slack 数字都不可信。本文件把它
#       变成真实约束。
#
# 时钟计划（地板阶段，见 docs/02-技术方案/14-必须项实施计划.md 步骤 2）：
#   27 MHz 晶振直连，单时钟域，零 PLL：
#     27_000_000 / 576 = 46875 Hz  采样率（整除，无抖动）
#     27_000_000 / 18  = 1.5 MHz   BCK = 46875 × 32（整除）
#   108 MHz（TDM 用）是独立实验，不进本工程。
#
# 注意：sample_en / bck_en / lrck 都是【使能脉冲】不是时钟——
#       单时钟域铁律（见 src/sim/README.md）。不要给它们 create_clock。
#=============================================================================

create_clock -name clk -period 37.037 [get_ports {clk}]

# 引脚 87 是板载按键 S1，高有效（2026-10-23 板上实测 + 官方 20K 例程确认）。
# 它只驱动 rst_gen 的消抖计数器，内部 rst_n 由 POR + 消抖同步产生，
# 所以这条异步输入不做建立/保持分析。
# ★ 端口在 2026-10-23 从 rst_n 改名为 btn_rst（极性纠正），此处必须同步。
set_false_path -from [get_ports {btn_rst}]
