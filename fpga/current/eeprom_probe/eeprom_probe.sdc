#=============================================================================
# eeprom_probe.sdc -- 27 MHz single clock domain, nothing else
#
# The design is one clock: the on-board 27 MHz crystal. There is no PLL, no
# derived clock, no enable-as-clock. SCL is generated by dividing the clock,
# not by a clock divider tree, so it must NOT get create_clock.
#
# 27 MHz -> 37.037 ns period. I2C runs at ~99.3 kHz (DIV=68 -> 4*68 = 272 clk
# per bit = 10.074 us), i.e. ~270 clk per SCL period. All the I2C pins are
# quasi-static from the timing tool's point of view; they only need the
# clock-to-pad delay to be sane, which the default analysis covers.
#=============================================================================

create_clock -name clk -period 37.037 [get_ports {clk}]

# SDA is an external open-drain line: it is driven by the EEPROM asynchronously
# with respect to clk. It goes through a 2-flop synchroniser in the RTL, so it
# is a false path as far as setup/hold is concerned.
set_false_path -from [get_ports {sda}]
