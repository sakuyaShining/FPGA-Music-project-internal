  "cards": [
    { "dot": "cyan", "title": "为什么演奏层只有一根轴", "items": [
      "一只手在不妨碍演奏时，只能稳定控制一到两个连续自由度",
      "而音色空间是 16 条泛音幅度以上（每条 8 位）；把十几维都交给瞬间动作在人体工程学上不成立",
      "所以维度不是被丢掉，而是被分配到不同的时间尺度上"
    ] },
    { "dot": "emerald", "title": "四个输入各管一件事", "items": [
      "结构层：一场演出设定一次，决定这把乐器的音色身份",
      "包络层：每个音符自动走一遍，不需要演奏者动手",
      "演奏层：每时每刻，右手位置轴（往右更多，抬手回中）",
      "作用范围：左手按住哪个音，这根轴就只作用于那个声部"
    ] },
    { "dot": "violet", "title": "现状与差距", "items": [
      "已实现：16×8 谱 RAM、叠加/替换、逐声部刷新（A1 / 0x63）、逐槽包络",
      "未实现：谱形随音符时间演化、演奏轴（0x5C TILT 协议已声明，RTL 尚未实现）",
      "因此包络层与演奏层是提案，落地需要新增判据与回归"
    ] },
    { "dot": "amber", "title": "与拉杆风琴的差别", "items": [
      "Hammond 拉杆是全局的、且频谱在时间上完全不动",
      "本方案是逐声部独立塑形，并让谱形随音符自身演化",
      "谱系是承认真实来源；差别落在控制粒度与时间行为上"
    ] }
  ]
