  "cards": [
    { "dot": "cyan", "title": "为什么是位置，不是碰与不碰", "items": [
      "二值触摸键只有单向：能加不能减；想从第 6 档回到第 2 档只能绕圈",
      "位置是绝对值，因此天然双向；抬手回中像弯音轮，是演奏语义",
      "一根手指桥接相邻两格可以给出中间档，共 15 档"
    ] },
    { "dot": "emerald", "title": "逐声部怎么变成动作", "items": [
      "左手按住某个音时，右手这根轴只作用于那个声部（0x63，修正案 A1）",
      "不按任何音时，它作用于全局底谱——也就是所有声部共享的设定",
      "引擎侧已支持，缺的只是把这个动作接到刷新触发上"
    ] },
    { "dot": "violet", "title": "演前与演奏分开", "items": [
      "演奏面只控制一根连续轴，手上不需要记菜单",
      "结构（16 条泛音各自多少）由设定模式或上位机在演前定",
      "这样演奏时不必腾出手去做编辑动作"
    ] },
    { "dot": "rose", "title": "全部未实现（诚实标注）", "items": [
      "0x5C TILT 协议里已声明，RTL 中没有实现",
      "包络层（谱形随音符时间演化）与设定模式都还是提案",
      "落地需要新增判据：双向性、回中、位置-亮度对应、桥接分辨率、防掉档"
    ] }
  ]
