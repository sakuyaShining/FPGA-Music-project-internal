  "issues": [
    {
      "id": "D-01",
      "impl_id": "I-01",
      "dimension": "D1",
      "title": "手指面积因人而异",
      "problem": "同一个轻按，不同人、不同湿度下读数差很多，绝对阈值会失效",
      "decision": "不做绝对映射，做相对映射：演奏前标定最轻/最重两端，中间线性插值",
      "rationale": "换人只需重标定，不必改代码",
      "open": "标定动作放在何时（开机 / 进入演奏模式）",
      "status": "decided",
      "impl": {
        "module": "expr_map.v",
        "registers": [
          "CAL_LO",
          "CAL_HI"
        ],
        "depends_on": [
          "I2C 模拟量"
        ],
        "criterion": "E2-D1-a"
      }
    },
    {
      "id": "D-02",
      "impl_id": "I-02",
      "dimension": "D1",
      "title": "起音瞬间的面积还在变化",
      "problem": "手指落下是几十毫秒的过程，按下那一刻测到的是最小值",
      "decision": "取起音窗内（约 10 ms）的峰值，不取瞬时值",
      "rationale": "弹得越轻越不易被误采为无力度",
      "spec_correction": true,
      "status": "decided",
      "impl": {
        "module": "expr_map.v",
        "registers": [
          "ATK_WIN"
        ],
        "resource": "32 个声部级保持寄存器（复用，非 38 通道）",
        "criterion": "E2-D1-b"
      }
    },
    {
      "id": "D-03",
      "impl_id": "I-03",
      "dimension": "D1",
      "title": "力度只改音量会像音量旋钮",
      "problem": "只缩放包络峰值，听感是音量旋钮，不像在弹",
      "decision": "力度同时影响音量与音色亮度；可选再影响起音速度",
      "rationale": "真实乐器重击更亮，这是力度最有说服力的部分",
      "open": "是否做重按起音更快（时间/收益权衡）",
      "status": "decided",
      "impl": {
        "module": "tdm_engine 声部增益 + 谱形缩放",
        "depends_on": [
          "I-13"
        ],
        "criterion": "E2-D1-c"
      }
    },
    {
      "id": "D-04",
      "impl_id": "I-04",
      "dimension": "D1",
      "title": "16 档够不够",
      "problem": "档位过多无益，曲线形状才决定手感",
      "decision": "16 档足够；曲线（线性/对数/分段）必须用耳朵定",
      "open": "曲线形状",
      "status": "decided",
      "impl": {
        "module": "expr_map.v",
        "registers": [
          "VEL_CURVE"
        ],
        "criterion": "E2-D1-d"
      }
    },
    {
      "id": "D-05",
      "impl_id": "I-05",
      "dimension": "D2",
      "title": "颤音触发方式的选择",
      "problem": "触后依赖模拟量，模拟量可能不可用",
      "decision": "触后为主；不可用时退到长按自动渐入（零传感依赖）",
      "rationale": "长按渐入是可用的兜底，保证 E2 颤音维不落空",
      "status": "decided",
      "impl": {
        "module": "输入层模式位",
        "registers": [
          "PERF_CTRL"
        ],
        "criterion": "E2-D2-a"
      }
    },
    {
      "id": "D-06",
      "impl_id": "I-06",
      "dimension": "D2",
      "title": "触后与力度共用同一信号",
      "problem": "起音窗要最大值，触后要起音之后的变化，信号相同",
      "decision": "时间窗分离：起音窗内归力度；之后的变化归触后，触后从 0 起累计",
      "risk": "同一信号两处判定会不一致 => 必须单点判定",
      "status": "decided",
      "impl": {
        "module": "expr_map.v 状态机",
        "criterion": "E2-X2"
      }
    },
    {
      "id": "D-07",
      "impl_id": "I-07",
      "dimension": "D2",
      "title": "颤音渐入时长",
      "problem": "渐入太短像开关，太长像没反应",
      "decision": "100-300 ms，默认 200 ms（真实歌唱颤音量级）",
      "spec_correction": true,
      "note": "触后从 0 起 => 天然先直音后加颤，这正是自然乐器行为，不要优化掉",
      "status": "decided",
      "impl": {
        "module": "pitch_mod 每声部深度平滑",
        "registers": [
          "VIB_IN_MS"
        ],
        "criterion": "E2-D2-b"
      }
    },
    {
      "id": "D-08",
      "impl_id": "I-08",
      "dimension": "D3",
      "title": "滑音 vs 快速连弹如何区分",
      "problem": "两种情形在事件层面几乎相同（旧音还在响时出现新音）",
      "decision": "依据手指是否离开面板（I2C 状态位）；拿不到则退化为时间窗 + 位移连续性",
      "status": "decided",
      "impl": {
        "module": "输入层",
        "source": "MPR121 状态位",
        "criterion": "E2-D3-a"
      }
    },
    {
      "id": "D-09",
      "impl_id": "I-09",
      "dimension": "D3",
      "title": "电极间隙会造成瞬断",
      "problem": "手指在键间移动必然经过 3 mm 间隙，出现短暂全松",
      "decision": "全松必须持续超过阈值（30-50 ms）才算真的抬手",
      "otherwise": "滑音会变成一串断音",
      "status": "decided",
      "impl": {
        "module": "slide_det.v",
        "registers": [
          "REL_MS"
        ],
        "open": "阈值数值待原型",
        "criterion": "E2-X3"
      }
    },
    {
      "id": "D-10",
      "impl_id": "I-10",
      "dimension": "D3",
      "title": "快速重复音与滑音争同一个阈值",
      "problem": "阈值短则滑音易断，长则快速重复音被当成滑音",
      "decision": "承认这是折中，数值靠原型实测；可选增强为相邻键连续经过的加权证据",
      "status": "decided",
      "impl": {
        "module": "slide_det.v",
        "registers": [
          "SLIDE_WIN"
        ],
        "criterion": "E2-X4"
      }
    },
    {
      "id": "D-11",
      "impl_id": "I-11",
      "dimension": "D4",
      "title": "泛音排中间掉格",
      "problem": "8 个键之间也有间隙，与 D-09 同源",
      "decision": "泛音排不发声，只需知道经过了哪几格，可用更宽松判据",
      "status": "decided",
      "impl": {
        "module": "slide_det.v",
