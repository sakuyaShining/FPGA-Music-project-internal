      }
    },
    {
      "id": "D-12",
      "impl_id": "I-12",
      "dimension": "D4",
      "title": "多指同时按泛音排算哪个位置",
      "problem": "两根手指同时落上，位置不唯一",
      "decision": "取最左被按格（可配置为首个落下的格）",
      "open": "最终取最左还是取首落，待手感确认",
      "status": "decided",
      "impl": {
        "module": "slide_det.v",
        "criterion": "E2-D4-b"
      }
    },
    {
      "id": "D-13",
