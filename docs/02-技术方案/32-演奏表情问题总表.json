    {
      "id": "D-14",
      "impl_id": "I-14",
      "dimension": "D4",
      "title": "亮度只能缓慢推拉",
      "problem": "逐声部谱形刷新（0x63）有几十个周期延迟",
      "decision": "亮度只做手势级缓慢推拉，不做音频级快速摆动",
      "rationale": "这是引擎刷新机制的真实上限，不是实现疏忽",
      "status": "decided",
      "impl": {
        "module": "约束性说明",
        "criterion": "E2-D4-d"
      }
    },
    {
      "id": "D-15",
      "impl_id": "I-15",
      "dimension": "D4",
      "title": "泛音键的双重身份会打架",
      "problem": "手指刚按下时，系统不知道是要点还是要滑",
      "decision": "点按加确认延迟 T（默认 150 ms）：稳定按住且无位移 => 点按生效；期间有移动 => 判为滑动，不切换泛音",
      "tradeoff": "泛音键点按有 T 延迟，可接受（它是设定动作，不是演奏动作）",
